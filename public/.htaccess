# ── React SPA routing ────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Una sola dirección para el sitio: www.firma7.com → firma7.com (evita contenido duplicado en Google).
  # El paso http → https ya lo hace el servidor.
  RewriteCond %{HTTP_HOST} ^www\.firma7\.com$ [NC]
  RewriteRule ^ https://firma7.com%{REQUEST_URI} [L,R=301]

  # Páginas públicas con su propio HTML (título, descripción e imagen propios para Google y WhatsApp).
  # Las genera scripts/prerender.mjs en cada build dentro de /_prerender/. Si no existe el archivo
  # (p. ej. un artículo publicado después del último despliegue) se sigue con la SPA de abajo.
  RewriteCond %{DOCUMENT_ROOT}/_prerender/$1.html -f
  RewriteRule ^(perfil|calculadora|blog|quiero-ser-aliado|aviso-de-privacidad|blog/[^/]+)/?$ /_prerender/$1.html [L]

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Alianzas sub-pages have their own HTML, don't redirect them
  RewriteCond %{REQUEST_URI} !^/alianzas/

  # Solo las rutas reales de la app van a React. Cualquier otra dirección devuelve un 404 de verdad
  # (antes devolvía 200 con la portada, lo que Google toma como contenido duplicado / "soft 404").
  # Si agregas una ruta nueva en App.tsx, agrégala también aquí.
  RewriteRule ^(perfil|calculadora|aprobado|espera|aviso-de-privacidad|documentos-recibidos|gracias|documentacion|aprobar-testimonio|admin|quiero-ser-aliado|blog(/.*)?)/?$ /index.html [L]
</IfModule>

# Página que ve el visitante en una dirección inexistente (React muestra su pantalla de "no encontrada"; el estado HTTP sigue siendo 404)
ErrorDocument 404 /index.html

# ── Security Headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Enable XSS filter in older browsers
  Header always set X-XSS-Protection "1; mode=block"

  # Control referrer information
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict browser features
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Force HTTPS on subsequent visits (1 year)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Content Security Policy
  # script-src ya no incluye 'unsafe-inline' ni 'unsafe-eval' — los 3 scripts
  # que antes iban inline (GA4, Meta Pixel, directorio de alianzas) ahora son
  # archivos externos propios (/analytics-init.js, /meta-pixel-init.js,
  # /alianzas-partners.js), cubiertos por 'self'. Si en el futuro se necesita
  # agregar OTRO script inline, no reintroducir 'unsafe-inline': o se mueve a
  # un archivo externo (preferido) o se agrega su hash sha256 específico.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://*.supabase.co https://www.google-analytics.com https://analytics.google.com https://api.leadconnectorhq.com https://n8n1.apexdigital.com.mx; frame-src https://api.leadconnectorhq.com https://link.msgsndr.com; object-src 'none'; base-uri 'self';"

  # Remove server signature
  Header always unset X-Powered-By
  Header always unset Server
</IfModule>

# ── Cache static assets aggressively ─────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # JS/CSS chunks (content-hashed filenames — safe to cache forever)
  <FilesMatch "\.(js|css)$">
    ExpiresDefault "access plus 1 year"
    Header append Cache-Control "public, immutable"
  </FilesMatch>

  # Images and fonts
  <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf)$">
    ExpiresDefault "access plus 1 year"
    Header append Cache-Control "public"
  </FilesMatch>

  # HTML — never cache (ensures React Router updates reach users)
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # Scripts que antes eran inline (GA4/Meta Pixel/alianzas) — a diferencia de
  # los chunks de Vite, su nombre de archivo NO cambia cuando se edita el
  # contenido, así que no pueden entrar en el cacheo agresivo de arriba (se
  # quedarían "pegados" en el navegador de los visitantes hasta por 1 año).
  <FilesMatch "^(analytics-init|meta-pixel-init|alianzas-partners|alianzas-landing)\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# ── Disable directory listing ─────────────────────────────────────────────────
Options -Indexes
